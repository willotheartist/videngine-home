<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Videngine — paste a URL, get a video</title>
<meta name="description" content="Videngine turns any web page into a finished video. It reads the page, writes the script, records the voiceover and renders both a vertical and a widescreen cut." />
<meta property="og:title" content="Videngine — paste a URL, get a video" />
<meta property="og:description" content="Turns any web page into a finished video. Vertical and widescreen, script and voiceover included." />
<meta property="og:type" content="website" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
:root{
  --paper:#E9E7E2;
  --paper-deep:#DEDBD4;
  --ink:#16181C;
  --ink-soft:#5A5D63;
  --ink-faint:#8E9198;
  --rule:#C9C6BE;
  --amber:#D98324;

  /* muted SMPTE-derived bars — the signature */
  --bar-1:#B8B3A8;
  --bar-2:#C9A227;
  --bar-3:#3E8E8C;
  --bar-4:#4B7B4A;
  --bar-5:#9C5A8C;
  --bar-6:#B24A3C;
  --bar-7:#3C5A8C;

  --wide:1180px;
}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:"Inter Tight",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-size:17px;
  line-height:1.55;
  letter-spacing:-.011em;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit}

.shell{max-width:var(--wide);margin:0 auto;padding:0 28px}

.mono{
  font-family:"JetBrains Mono",ui-monospace,Menlo,monospace;
  font-size:12px;
  letter-spacing:.02em;
}

/* ─── colour bars ─────────────────────────────── */
.bars{display:flex;height:5px;width:100%}
.bars span{flex:1}
.bars span:nth-child(1){background:var(--bar-1)}
.bars span:nth-child(2){background:var(--bar-2)}
.bars span:nth-child(3){background:var(--bar-3)}
.bars span:nth-child(4){background:var(--bar-4)}
.bars span:nth-child(5){background:var(--bar-5)}
.bars span:nth-child(6){background:var(--bar-6)}
.bars span:nth-child(7){background:var(--bar-7)}

/* ─── top bar ─────────────────────────────────── */
.top{border-bottom:1px solid var(--rule)}
.top-in{
  max-width:var(--wide);margin:0 auto;padding:14px 28px;
  display:flex;align-items:center;justify-content:space-between;gap:20px;
}
.wordmark{
  font-family:"Archivo",sans-serif;
  font-variation-settings:"wdth" 118,"wght" 700;
  font-size:17px;letter-spacing:.01em;text-transform:lowercase;
}
.top .tc{color:var(--ink-faint)}
.top .enter{
  text-decoration:none;color:var(--ink);
  border:1px solid var(--ink);border-radius:5px;
  padding:7px 14px;font-size:13.5px;font-weight:600;
  transition:background .15s,color .15s;
}
.top .enter:hover{background:var(--ink);color:var(--paper)}

/* ─── hero ────────────────────────────────────── */
.hero{padding:82px 0 0}
.eyebrow{
  color:var(--ink-faint);text-transform:uppercase;
  letter-spacing:.14em;font-size:11px;font-weight:500;
  font-family:"JetBrains Mono",ui-monospace,monospace;
  margin:0 0 22px;
}
h1{
  font-family:"Archivo",sans-serif;
  font-variation-settings:"wdth" 122,"wght" 700;
  font-size:clamp(2.9rem,8.2vw,6.2rem);
  line-height:.92;
  letter-spacing:-.035em;
  margin:0 0 26px;
  max-width:14ch;
}
h1 .dim{color:var(--ink-faint)}
.lede{
  font-size:clamp(1.05rem,2vw,1.32rem);
  line-height:1.5;color:var(--ink-soft);
  max-width:52ch;margin:0 0 40px;
}

/* URL field */
.field{
  display:flex;align-items:center;gap:12px;
  background:var(--paper-deep);
  border:1px solid var(--rule);
  border-radius:7px;
  padding:15px 18px;
  max-width:660px;
  margin:0 0 10px;
}
.field .dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--amber);flex:none;
}
.field .url{
  font-family:"JetBrains Mono",ui-monospace,monospace;
  font-size:14px;color:var(--ink);
  white-space:nowrap;overflow:hidden;
}
.caret{
  display:inline-block;width:8px;height:1.05em;
  background:var(--ink);vertical-align:-2px;margin-left:2px;
  animation:blink 1.1s steps(1) infinite;
}
@keyframes blink{0%,50%{opacity:1}50.01%,100%{opacity:0}}
.field-note{color:var(--ink-faint);margin:0 0 52px}

/* scene strip */
.strip-head{
  display:flex;align-items:baseline;justify-content:space-between;
  border-top:1px solid var(--rule);
  padding-top:12px;margin-bottom:14px;
  color:var(--ink-faint);
}
.strip{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:10px;
  padding-bottom:78px;
}
.cell{opacity:0;transform:translateY(9px)}
.dealt .cell{animation:deal .5s cubic-bezier(.2,.7,.3,1) forwards}
.dealt .cell:nth-child(1){animation-delay:.05s}
.dealt .cell:nth-child(2){animation-delay:.13s}
.dealt .cell:nth-child(3){animation-delay:.21s}
.dealt .cell:nth-child(4){animation-delay:.29s}
.dealt .cell:nth-child(5){animation-delay:.37s}
.dealt .cell:nth-child(6){animation-delay:.45s}
@keyframes deal{to{opacity:1;transform:none}}
.frame{
  aspect-ratio:9/16;
  background:var(--paper-deep);
  border:1px solid var(--rule);
  border-radius:4px;
  position:relative;
  overflow:hidden;
  margin-bottom:8px;
}
.frame::after{
  content:"";position:absolute;left:9px;right:9px;bottom:11px;
  height:2px;background:var(--ink);opacity:.16;
}
.frame::before{
  content:"";position:absolute;left:9px;bottom:19px;
  width:52%;height:2px;background:var(--ink);opacity:.30;
}
.cell:hover .frame{border-color:var(--ink)}
.cell .tc{color:var(--ink-faint);display:block}
.cell .lbl{font-size:13px;font-weight:500;line-height:1.3;display:block;margin-top:1px}

@media(max-width:820px){
  .strip{grid-template-columns:repeat(3,1fr)}
  .cell:nth-child(n+4){display:none}
}

/* ─── sections ────────────────────────────────── */
.band{border-top:1px solid var(--rule)}
.band-in{padding:64px 0}
.kicker{
  display:flex;align-items:baseline;gap:14px;
  margin:0 0 34px;
}
.kicker h2{
  font-family:"Archivo",sans-serif;
  font-variation-settings:"wdth" 112,"wght" 600;
  font-size:clamp(1.3rem,3vw,1.85rem);
  letter-spacing:-.02em;margin:0;
}
.kicker .n{color:var(--ink-faint)}

/* steps — a real sequence, so numbered */
.steps{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:0;
  border-top:1px solid var(--rule);
}
.step{
  padding:22px 20px 26px 0;
  border-right:1px solid var(--rule);
}
.step:last-child{border-right:none;padding-right:0}
.step .n{
  color:var(--amber);font-weight:500;display:block;margin-bottom:12px;
}
.step h3{
  font-size:15.5px;font-weight:600;margin:0 0 7px;letter-spacing:-.015em;
}
.step p{margin:0;font-size:14.5px;line-height:1.5;color:var(--ink-soft)}
@media(max-width:860px){
  .steps{grid-template-columns:1fr 1fr}
  .step{border-right:none;border-bottom:1px solid var(--rule);padding-right:0}
  .step:nth-child(odd){padding-right:20px}
  .step:last-child{border-bottom:none}
}
@media(max-width:520px){
  .steps{grid-template-columns:1fr}
  .step:nth-child(odd){padding-right:0}
}

/* outputs — actual aspect ratios */
.outs{display:flex;gap:26px;align-items:flex-end;flex-wrap:wrap}
.out .box{
  background:var(--paper-deep);
  border:1px solid var(--rule);
  border-radius:5px;
  position:relative;
}
.out .box::after{
  content:"";position:absolute;inset:auto 12px 14px 12px;
  height:2px;background:var(--ink);opacity:.14;
}
.out.v .box{width:132px;aspect-ratio:9/16}
.out.h .box{width:340px;aspect-ratio:16/9}
.out .meta{margin-top:11px}
.out .meta b{display:block;font-size:14.5px;font-weight:600}
.out .meta span{color:var(--ink-faint)}
@media(max-width:520px){.out.h .box{width:250px}}

/* specs */
.specs{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:24px;border-top:1px solid var(--rule);padding-top:24px;
}
.specs div b{
  display:block;
  font-family:"Archivo",sans-serif;
  font-variation-settings:"wdth" 108,"wght" 600;
  font-size:1.55rem;letter-spacing:-.02em;
}
.specs div span{color:var(--ink-faint)}
@media(max-width:680px){.specs{grid-template-columns:1fr 1fr;gap:20px}}

/* footer */
footer{border-top:1px solid var(--rule)}
.foot-in{
  max-width:var(--wide);margin:0 auto;padding:26px 28px 40px;
  display:flex;justify-content:space-between;align-items:center;
  gap:18px;flex-wrap:wrap;color:var(--ink-faint);
}
.foot-in a{color:var(--ink-soft);text-decoration:none;border-bottom:1px solid var(--rule)}
.foot-in a:hover{color:var(--ink);border-color:var(--ink)}

:focus-visible{outline:2px solid var(--amber);outline-offset:3px;border-radius:3px}

@media(prefers-reduced-motion:reduce){
  .cell{opacity:1;transform:none}
  .dealt .cell{animation:none}
  .caret{animation:none}
  *{transition:none!important}
}
</style>
</head>
<body>

<div class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

<header class="top">
  <div class="top-in">
    <div class="wordmark">videngine</div>
    <div class="mono tc" aria-hidden="true">00:00:57:12</div>
    <a class="enter" href="https://app.videngine.io">Open the studio</a>
  </div>
</header>

<main>
  <section class="hero shell">
    <p class="eyebrow">Programmatic video</p>
    <h1>Paste a URL.<br /><span class="dim">Get a video.</span></h1>
    <p class="lede">Videngine reads a web page, writes the script, records the voiceover, and renders it as a finished cut. A listing, an article, a guide — anything with a page behind it.</p>

    <div class="field">
      <span class="dot" aria-hidden="true"></span>
      <span class="url" id="url">https://</span><span class="caret" aria-hidden="true"></span>
    </div>
    <p class="mono field-note">One field. No timeline, no editor, no footage to source.</p>

    <div class="strip-head">
      <span class="mono">SCENE PLAN</span>
      <span class="mono">9 SCENES · 1710 FRAMES · 30 FPS</span>
    </div>
    <div class="strip" id="strip">
      <div class="cell"><div class="frame"></div><span class="mono tc">00:00</span><span class="lbl">Opening frame</span></div>
      <div class="cell"><div class="frame"></div><span class="mono tc">00:06</span><span class="lbl">The hook</span></div>
      <div class="cell"><div class="frame"></div><span class="mono tc">00:13</span><span class="lbl">What it is</span></div>
      <div class="cell"><div class="frame"></div><span class="mono tc">00:19</span><span class="lbl">Detail</span></div>
      <div class="cell"><div class="frame"></div><span class="mono tc">00:26</span><span class="lbl">Detail</span></div>
      <div class="cell"><div class="frame"></div><span class="mono tc">00:32</span><span class="lbl">Where to go</span></div>
    </div>
  </section>

  <section class="band">
    <div class="shell band-in">
      <div class="kicker"><span class="mono n">01–05</span><h2>What happens after you paste</h2></div>
      <div class="steps">
        <div class="step">
          <span class="mono n">01</span>
          <h3>Reads the page</h3>
          <p>Pulls the text and every usable image, and skips the logos, banners and blocked assets.</p>
        </div>
        <div class="step">
          <span class="mono n">02</span>
          <h3>Writes the script</h3>
          <p>A voiceover built only from what the page actually says, with a scene planned against each image.</p>
        </div>
        <div class="step">
          <span class="mono n">03</span>
          <h3>Records the voice</h3>
          <p>A consistent narrator across every video you make, in the voice you pick per brand.</p>
        </div>
        <div class="step">
          <span class="mono n">04</span>
          <h3>Renders both cuts</h3>
          <p>Vertical and widescreen from the same scene plan, with your titles, watermark and music bed.</p>
        </div>
        <div class="step">
          <span class="mono n">05</span>
          <h3>Hands you the files</h3>
          <p>Two MP4s and the titles, descriptions and tags to post them with.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="shell band-in">
      <div class="kicker"><span class="mono n">OUT</span><h2>Two cuts, one pass</h2></div>
      <div class="outs">
        <div class="out v">
          <div class="box"></div>
          <div class="meta"><b>Vertical</b><span class="mono">1080 × 1920 · 9:16</span></div>
        </div>
        <div class="out h">
          <div class="box"></div>
          <div class="meta"><b>Widescreen</b><span class="mono">1920 × 1080 · 16:9</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="shell band-in">
      <div class="kicker"><span class="mono n">AT SCALE</span><h2>Or point it at a whole site</h2></div>
      <p class="lede" style="margin-bottom:36px">Give Videngine a sitemap instead of a single URL. Pick the pages worth a video, queue them, and leave it running. It works through the list on its own and keeps going if you close the tab.</p>
      <div class="specs">
        <div><b>1 field</b><span class="mono">to start a video</span></div>
        <div><b>~55 sec</b><span class="mono">typical finished cut</span></div>
        <div><b>Unattended</b><span class="mono">queue keeps running</span></div>
        <div><b>Re-editable</b><span class="mono">swap a shot, render again</span></div>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="foot-in">
    <span class="mono">VIDENGINE.IO</span>
    <span class="mono">Built by <a href="https://wallandfifth.com">Wall &amp; Fifth</a></span>
  </div>
</footer>

<div class="bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

<script>
(function(){
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var target = "https://yoursite.com/the-page-you-want-a-video-of";
  var el = document.getElementById("url");
  var strip = document.getElementById("strip");

  if (reduced) { el.textContent = target; strip.classList.add("dealt"); return; }

  var i = 8; // start after "https://"
  el.textContent = target.slice(0, i);
  var t = setInterval(function(){
    i++;
    el.textContent = target.slice(0, i);
    if (i >= target.length) {
      clearInterval(t);
      setTimeout(function(){ strip.classList.add("dealt"); }, 260);
    }
  }, 26);
})();
</script>

</body>
</html>
